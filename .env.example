# Copy to apps/web/.env.local for local development, or run `vercel env pull` inside apps/web.
# Never commit real values. Production and Preview values live in Vercel.

# Buffer OAuth app client. Use the development client locally; its redirect URI is
# https://localhost:3000/api/auth/buffer/callback (next dev runs with --experimental-https).
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_REDIRECT_URI=https://localhost:3000/api/auth/buffer/callback

# Optional. Space-separated scopes to request at connect, when the app client cannot have all
# of them (for example without notes:read and notes:write). Empty requests the full set.
BUFFER_SCOPES=

# Optional. "true" (the default) offers Buffer's Creator Camp prompts in the setup wizard, with the
# credit "Prompts from Buffer's Creator Camp". Buffer allows this; "false" hides the option.
FEATURE_CREATOR_CAMP=true

# Optional. "true" saves feedback replies as Notes on the draft in Buffer (experimental API).
FEATURE_BUFFER_NOTES=false

# Optional, local development and tests only: point the app at the mock Buffer server
# (pnpm --filter @daydeck/web mock:buffer) instead of the real one. The mock's client is
# BUFFER_CLIENT_ID=mock-client and BUFFER_CLIENT_SECRET=mock-secret.
# BUFFER_AUTH_URL=http://localhost:4010
# BUFFER_API_URL=http://localhost:4010/graphql

# 32 random bytes, base64. Encrypts Buffer tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# PostgreSQL 18, as on Neon. On Vercel the Neon integration sets both. DATABASE_URL is the pooled
# address (its host contains "-pooler"); migrations use the direct, unpooled address.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Inngest background jobs: the progress checks, closing challenges and the daily cleanup.
# Locally, leave both empty, set INNGEST_DEV=1 and run the Inngest dev server instead.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1

# Prompt matching: "jev" (TypeSafe Jev), "llm" (Claude, the fallback) or "keyword" (no key,
# for local runs). Without the chosen key, posts written outside Daydeck wait under "Other posts".
# The privacy page names the AI service only when its key is set.
MATCHER_PROVIDER=jev
JEV_API_KEY=
# Only with MATCHER_PROVIDER=llm: the Claude API key for the fallback matcher.
ANTHROPIC_API_KEY=

# Sentry error tracking. Leave empty to turn Sentry off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Who runs this copy of Daydeck: shown on the privacy page as the person or team responsible for
# people's data (the "controller" in the GDPR), with an address for privacy questions.
PRIVACY_CONTACT_NAME=
PRIVACY_CONTACT_EMAIL=

# Optional: the demo challenge, shown first under "Popular challenges" on the homepage with a
# "Demo" label. `pnpm --filter @daydeck/db demo:seed` creates it with sample members and prints
# its invite code (the part after /c/). Run it again to move the sample dates up to today.
DEMO_INVITE_CODE=
# Optional: the last day (YYYY-MM-DD, UTC) the homepage shows the demo. Empty: no end.
# Example, one day after Buffer Commit's judging: DEMO_UNTIL=2026-11-21
DEMO_UNTIL=
# Optional, demo:seed only: host the demo from a real account (its Buffer account ID) instead of
# the sample host. That account must have signed in to Daydeck once.
DEMO_HOST_BUFFER_ACCOUNT_ID=

# Optional, tests only: a production build for end-to-end tests in its own folder, so it never
# clashes with a running `next dev`. Example: NEXT_DIST_DIR=.next-e2e
# NEXT_DIST_DIR=
